# Public URL of the API on the VPS (no trailing slash, without /api)
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# mvp (default) or full; the same value as the API's APP_MODE. Anything but full means mvp.
NEXT_PUBLIC_APP_MODE=mvp
NEXT_PUBLIC_BRAND=GóiĐề
NEXT_PUBLIC_SUPPORT_EMAIL=hotro@example.com
NEXT_PUBLIC_SUPPORT_ZALO=
