# Copy to .env and fill in. Never commit .env.
NODE_ENV=development
# mvp (default when unset): only the guest path, upload, review, Themis export; accounts, billing, growth and AI
# answer 404 and AI stays off even with a key. full: everything. Set NEXT_PUBLIC_APP_MODE on the web to the same value.
APP_MODE=mvp
PORT=4000
DATABASE_URL=postgres://agg:agg@127.0.0.1:5433/agg
# The schema comes from the migrations, which the API runs at startup. true only for a throwaway local database
# (alters tables to match the code after the migrations); refused in production.
DB_SYNC=false
# openssl rand -hex 32
JWT_SECRET=
IP_HASH_SECRET=
# Comma-separated; these addresses sign in as administrators.
ADMIN_EMAILS=
FRONTEND_URL=http://localhost:3000
PUBLIC_API_URL=http://localhost:4000
CORS_ORIGINS=http://localhost:3000
# Number of reverse proxies in front of the API on the VPS (Caddy = 1).
TRUST_PROXY=
MAX_UPLOAD_MB=50
EXTRACTION_CONCURRENCY=3

# AI (all optional: without a key the rule-based parser reads documents and AI actions are off)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5
CLAUDE_GUEST_MODEL=claude-haiku-5-5
CLAUDE_WRITER_MODEL=
CLAUDE_TESTGEN_MODEL=
GUEST_AI_READER=true

# E-mail (required in production: sign-in codes)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=GoiDe <no-reply@example.com>
SALES_NOTIFY_EMAIL=

# Payments: a provider is offered only when all its keys are set.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_PAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
MOMO_PARTNER_CODE=
MOMO_ACCESS_KEY=
MOMO_SECRET_KEY=
MOMO_ENDPOINT=https://test-payment.momo.vn/v2/gateway/api/create
# VietQR bank transfer, confirmed by a SePay webhook (Authorization: Apikey <SEPAY_WEBHOOK_KEY>)
VIETQR_BANK_ID=
VIETQR_BANK_NAME=
VIETQR_ACCOUNT_NUMBER=
VIETQR_ACCOUNT_NAME=
SEPAY_WEBHOOK_KEY=
