# GD-7: Caddy writes no access log, but its error log (always on) records each failed request, for example a 502
# while the API restarts: the client's IP and every header, including the guest's access key and browser id. The
# privacy page promises the logs hold none of these, so they are removed from every log entry here.
{
	log default {
		format filter {
			wrap json
			fields {
				request>remote_ip delete
				request>remote_port delete
				request>client_ip delete
				request>headers delete
			}
		}
	}
}

{$API_DOMAIN} {
	encode gzip
	# Uploads up to the API's MAX_UPLOAD_MB (several files per request).
	request_body {
		max_size 300MB
	}
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		-Server
	}
	reverse_proxy api:4000 {
		# Test suggestions run code on the AI side and may take a few minutes.
		transport http {
			read_timeout 5m
			write_timeout 5m
		}
	}
}
