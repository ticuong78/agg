{$API_DOMAIN} {
	encode gzip
	# Uploads up to the API's MAX_UPLOAD_MB (several files per request).
	request_body {
		max_size 300MB
	}
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		-Server
	}
	reverse_proxy api:4000 {
		# Test suggestions run code on the AI side and may take a few minutes.
		transport http {
			read_timeout 5m
			write_timeout 5m
		}
	}
}
