{
  "name": "agg",
  "private": true,
  "packageManager": "pnpm@12.17.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "prepare": "husky",
    "build": "pnpm -r build",
    "build:contracts": "pnpm --filter @agg/contracts build",
    "dev:api": "pnpm --filter @agg/api dev",
    "dev:web": "pnpm --filter @agg/web dev",
    "infra:up": "docker compose up -d postgres",
    "infra:down": "docker compose down",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@types/node": "^24.0.0",
    "husky": "^9.1.7",
    "typescript": "^5.9.3"
  }
}
